{
  "compilerOptions": {
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "resolveJsonModule": true,

    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ES5",
    "typeRoots": ["./node_modules/@sm003/autojs6-dts/declarations", "./node_modules/@types", "types"],

    "outDir": "./dist",
    "baseUrl": "src",
    "paths": {
      "@/*": ["modules/*"]
    }
  },
  "exclude": ["node_modules"]
}
