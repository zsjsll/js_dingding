{
  "compilerOptions": {
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "resolveJsonModule": true,

    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "esnext",
    // "typeRoots": [
    //   "./node_modules/@sm003/autojs6-dts/declarations",
    //   "./node_modules/@types",
    //   "types"
    // ],

    // "outDir": "./dist",
    // "rootDir": "./src",
    "paths": {
      "@/*": ["./src/modules/*"]
    }
  },
  "include": [
    "node_modules/@sm003/autojs6-dts/**/*.d.ts",
    "src",
    "types",
    "rspack.config.ts"
  ]
  // "exclude": ["node_modules"]
}
