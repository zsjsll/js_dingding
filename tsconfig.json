{
  "compilerOptions": {
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "resolveJsonModule": true,

    "module": "commonjs",
    "moduleResolution": "bundler",
    "target": "esnext",

    "paths": {
      "@/*": ["./src/modules/*"]
    }
  },
  "include": ["node_modules/@sm003/autojs6-dts/**/*.d.ts", "src", "types", "rspack.config.ts"]
}
