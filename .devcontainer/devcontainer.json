// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/alpine
{
  "name": "js_dingding",
  // Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
  "image": "mcr.microsoft.com/devcontainers/javascript-node:4-24-trixie",
  "features": {
    "ghcr.io/michidk/devcontainers-features/bun:1": {}
  },

  // Features to add to the dev container. More info: https://containers.dev/features.
  // "features": {},

  // Use 'forwardPorts' to make a list of ports inside the container available locally.
  // "forwardPorts": [],

  // Use 'postCreateCommand' to run commands after the container is created.
  // "postCreateCommand": "sudo ln -fs $(which bun) /usr/local/bin/node",

  // Configure tool-specific properties.
  // "customizations": {},
  "customizations": {
    "vscode": {
      "extensions": [
        "zhong.auto-js-vsce-fixed-new",
        "oven.bun-vscode",
        "formulahendry.code-runner",
        "abierbaum.vscode-file-peek",
        "mkxml.vscode-filesize",
        "mhutchie.git-graph",
        "donjayamanne.githistory",
        "oderwat.indent-rainbow",
        "idered.npm",
        "johnny-zhao.oai-compatible-copilot",
        "oxc.oxc-vscode",
        "christian-kohler.path-intellisense",
        "mahatolalit.sizecostimport",
        "antfu.smart-clicks",
        "holysheng.snaketocamel",
        "meganrogge.template-string-converter",
        "ChakrounAnas.turbo-console-log",
        "TypeScriptTeam.native-preview"
      ]
    }
  },
  // Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
  "remoteUser": "root"
}
